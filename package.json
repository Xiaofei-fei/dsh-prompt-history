{
  "name": "dsh-prompt-history",
  "version": "1.6.7",
  "description": "DSH web plugin for the composer: shell-style prompt history (Up/Down with prefix search, Ctrl+R reverse search), Codex-style history completion and next-prompt prediction ghosted in the empty input (Tab or → to accept), a selection toolbar (copy / quote / ask in side chat), right-click paste, a draggable chat TOC, and a side chat that runs a parallel agent thread in the right sidebar — forked with the full conversation, dockable/splittable/floatable, with bidirectional bridging to the main chat and a parallel-write guard. Fully internationalized (zh/en), no configuration required.",
  "keywords": [
    "autocomplete",
    "composer",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "history",
    "i18n",
    "input",
    "plugin",
    "prediction",
    "prompt",
    "side-chat",
    "terminal",
    "toc"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xiaofei-fei/dsh-prompt-history"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.es.md",
    "README.pt.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.2.5",
    "puppeteer-core": "^24.10.0",
    "react": "^18.2.0",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "unrun": "^0.3.1"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "prepare": "pnpm build",
    "test": "pnpm run typecheck && pnpm run test:e2e",
    "test:e2e": "node test/e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  }
}
